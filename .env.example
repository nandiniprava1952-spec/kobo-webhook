# Copy this file to ".env" (same folder as main.py) and fill in your real values.
# Do NOT commit the real .env file to git / share it publicly -- it holds a secret token.

KOBO_API_TOKEN=paste_your_kobo_api_token_here
MAIN_ASSET_UID=paste_your_autoclave_form_uid_here
KOBO_BASE_URL=https://kf.kobotoolbox.org
WEBHOOK_SHARED_SECRET=pick-any-random-string-here

# Optional: force a form redeploy after each CSV update. Usually NOT needed --
# Kobo picks up refreshed media file content on next device sync without it.
# Set to true only if you find pulldata() isn't seeing updates otherwise.
FORCE_REDEPLOY=false

# Optional: where the local CSV lives and what it's named on Kobo.
# Defaults shown below match your current form's pulldata() calls.
CSV_PATH=facility_master_redesigned.csv
CSV_FILENAME_ON_KOBO=facility_master_redesigned.csv
